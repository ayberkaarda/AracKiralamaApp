<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console tool for the application icon and the README images. It never shows a window:
    forms are created with in-memory services and an invented fleet and drawn with Control.DrawToBitmap.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AracKiralama.Screenshots</AssemblyName>
    <RootNamespace>AracKiralama.Screenshots</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AracKiralama.UI\AracKiralama.UI.csproj" />
  </ItemGroup>

</Project>
