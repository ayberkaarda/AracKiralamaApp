<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AracKiralama.UI</RootNamespace>
    <AssemblyName>AracKiralama</AssemblyName>
    <Product>Araç Kiralama</Product>
    <NeutralLanguage>tr-TR</NeutralLanguage>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <UserSecretsId>arac-kiralama-ui</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings.json" Condition="Exists('appsettings.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Original artwork, rasterized from assets/logo.svg by tools/Screenshots (icons command). -->
    <EmbeddedResource Include="..\..\assets\logo-256.png" Link="Assets\logo-256.png" LogicalName="AracKiralama.UI.Assets.logo-256.png" />
    <EmbeddedResource Include="..\..\assets\app.ico" Link="Assets\app.ico" LogicalName="AracKiralama.UI.Assets.app.ico" />
    <!-- Car photographs from Wikimedia Commons under free licenses; every file is credited in docs/CREDITS.md. -->
    <EmbeddedResource Include="Assets\Cars\*.jpg" LogicalName="AracKiralama.UI.Assets.Cars.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AracKiralama.UI.Tests" />
    <InternalsVisibleTo Include="AracKiralama.Screenshots" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AracKiralama.Business\AracKiralama.Business.csproj" />
    <ProjectReference Include="..\AracKiralama.Data\AracKiralama.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
