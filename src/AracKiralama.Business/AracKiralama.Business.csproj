<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sessions can only be issued by AuthService and SetupService; tests build them directly. -->
    <InternalsVisibleTo Include="AracKiralama.Business.Tests" />
    <InternalsVisibleTo Include="AracKiralama.Data.Tests" />
    <InternalsVisibleTo Include="AracKiralama.UI.Tests" />
    <!-- Lets Moq create proxies of internal types. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AracKiralama.Domain\AracKiralama.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>

</Project>
